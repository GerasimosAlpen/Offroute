# Offroute backend environment.
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is gitignored. Never commit real credentials — this is a public repo.

# ─── Database (required) ──────────────────────────────────────────────────────
#
# Two URLs, both pointing at the same PostgreSQL database (Supabase-hosted in
# the team's setup). They are NOT interchangeable:
#
#   DATABASE_URL — used by the running server (src/prisma/prisma.service.ts).
#                  Points at the pgbouncer transaction-mode pooler on port 6543.
#   DIRECT_URL   — used by migrations and the seed script (prisma.config.ts,
#                  prisma/seed.ts). Must be a DIRECT connection on port 5432,
#                  because pgbouncer's transaction mode cannot run the DDL
#                  that migrations need.
#
# Get both from Supabase: Project Settings > Database > Connection string.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ─── Admin secret (required for destructive endpoints) ────────────────────────
#
# Guards POST /admin/reseed, which deletes every row in every table before
# reseeding. Without this set, that endpoint returns 503 rather than running —
# it fails closed on purpose.
#
# Generate one:   openssl rand -hex 32
#
# The radar operator console sends it as the `x-admin-token` header, read from
# localStorage. Set it once per operator machine, from devtools:
#   localStorage.setItem("offroute.adminToken", "<the same value as below>")

ADMIN_TOKEN=""

# ─── Server ───────────────────────────────────────────────────────────────────

# Port the API listens on. The frontend defaults to http://localhost:3000, and
# the Tauri CSP allows any http/https origin, so changing this is safe.
PORT=3000

# ─── CORS ─────────────────────────────────────────────────────────────────────
#
# Comma-separated EXTRA allowed origins, appended to the built-in defaults
# (http://localhost:1420 and tauri://localhost — see src/cors.ts).
#
# Needed when field devices reach the command post over a LAN rather than
# localhost. Include the scheme and port, no trailing slash.
#
# Example:
#   CORS_ORIGINS="http://192.168.1.10:1420,http://192.168.1.11:1420"

CORS_ORIGINS=""

# ─── Node ─────────────────────────────────────────────────────────────────────
# Set to "production" when deploying.
NODE_ENV=development
