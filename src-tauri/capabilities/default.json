{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    "os:default",
    "store:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "sql:allow-close",
    "geolocation:default",
    "geolocation:allow-check-permissions",
    "geolocation:allow-request-permissions",
    "blec:default"
  ]
}
